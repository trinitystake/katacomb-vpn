iptables -w 5 -A KATACOMB_KILLSWITCH -o sntl0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
iptables -w 5 -A KATACOMB_KILLSWITCH -j DROP
iptables -w 5 -A OUTPUT -j KATACOMB_KILLSWITCH
ip6tables -S
