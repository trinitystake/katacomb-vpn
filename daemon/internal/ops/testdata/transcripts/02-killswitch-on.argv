iptables -w 5 -N KATACOMB_KILLSWITCH
iptables -w 5 -A KATACOMB_KILLSWITCH -o lo -j ACCEPT
iptables -w 5 -A KATACOMB_KILLSWITCH -o sntl0 -j ACCEPT
