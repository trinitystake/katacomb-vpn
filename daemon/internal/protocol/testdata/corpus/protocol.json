      "encoded": "{\"id\":3,\"ok\":false,\"error\":\"unknown op: nope\"}"
    },
    {
      "name": "invalid-json-reply",
      "response": {
        "id": 0,
        "ok": false,
        "error": "invalid JSON"
      },
      "encoded": "{\"id\":0,\"ok\":false,\"error\":\"invalid JSON\"}"
    },
    {
      "name": "invalid-request-reply",
      "response": {
        "id": 0,
        "ok": false,
        "error": "invalid request"
      },
      "encoded": "{\"id\":0,\"ok\":false,\"error\":\"invalid request\"}"
    }
  ],
  "_staleDaemonMarker": "What an OLD daemon replies to an op it does not know. vpn-manager matches this prefix to detect a daemon left running across an upgrade; it is the fallback for daemons too old to answer protocol_version.",
  "unknownOpPrefix": "unknown op: "
}
