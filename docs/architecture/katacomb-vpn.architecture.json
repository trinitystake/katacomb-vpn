  "cards": [
    {
      "dot": "cyan",
      "title": "Process separation",
      "items": [
        "Sandboxed renderer, no Node integration",
        "window.api is the only channel into main"
      ]
    },
    {
      "dot": "emerald",
      "title": "Privilege",
      "items": [
        "One Go binary: root daemon or pkexec one shot",
        "tun2socks and AmneziaWG are linked in, not vendored"
      ]
    },
    {
      "dot": "rose",
      "title": "Node trust",
      "items": [
        "Node data becomes config that root runs",
        "config-guard allow-lists it, app side and root side",
        "The handshake accepts any certificate"
      ]
    },
    {
      "dot": "amber",
      "title": "Money",
      "items": [
        "A failed handshake refunds the new session",
        "One connection at a time, enforced in main"
      ]
    }
  ]
