{
  "name": "katacomb-vpn",
  "version": "1.0.2",
  "description": "Katacomb VPN Desktop Client",
  "author": "Katacomb <noreply@katacomb.vpn>",
  "homepage": "https://katacomb.vpn",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:daemon",
    "build:daemon": "node scripts/build-daemon.mjs",
    "preview": "electron-vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --linux",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "checksums": "cd dist && sha256sum katacomb-vpn_*_amd64.deb katacomb-vpn-*.AppImage > SHA256SUMS && sha256sum -c SHA256SUMS"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@sentinel-official/sentinel-js-sdk": "^2.0.4",
    "@tanstack/react-virtual": "^3.13.0",
    "bip39": "^3.1.0",
    "flag-icons": "^7.3.2",
    "long": "^5.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.38.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^41.10.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
