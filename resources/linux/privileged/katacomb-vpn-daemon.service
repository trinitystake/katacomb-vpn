[Unit]
Description=Katacomb VPN privileged helper daemon
After=network.target

[Service]
Type=simple
# One static Go binary serves both modes: `daemon` here (protocol v1 on the
# socket, no password prompts for the GUI) and the pkexec one-shot verbs. It is
# installed by the postinstall to /usr/local/bin, the same path the polkit policy
# pins, so nothing under /opt is referenced here.
ExecStart=/usr/local/bin/katacomb-vpn-helper daemon
# systemd creates/owns /run/katacomb-vpn (where the daemon binds its socket).
RuntimeDirectory=katacomb-vpn
RuntimeDirectoryMode=0755
# Keep the state files (tun.state, openvpn.pid, killswitch.state) across
# `systemctl restart`, which the postinstall runs on every upgrade. Without this
# every upgrade wiped them, so the next tun-down found no pid and no remote host
# and left the node's /32 and the bypass routes behind. Still removed on `stop`,
# which the postrm only reaches after its own teardown verbs.
RuntimeDirectoryPreserve=restart
Restart=on-failure
RestartSec=2

# Conservative hardening (finding: systemd daemon confinement). These do NOT
# interfere with the daemon's work (spawning wg-quick/iptables/ip/tun2socks,
# writing /etc/resolv.conf, binding its AF_UNIX socket). Intentionally
# omitted: ProtectSystem/ProtectKernelModules (would block wg-quick's modprobe and
# the /etc/resolv.conf rewrite), RestrictAddressFamilies (ip/iptables need
# AF_NETLINK), and a CapabilityBoundingSet (wg-quick needs broad caps) — those
# require on-target verification before enabling.
NoNewPrivileges=true
ProtectHome=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
