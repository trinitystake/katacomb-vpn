[Unit]
Description=Sentinel dVPN privileged helper daemon
Documentation=https://sentinel.co
After=network.target

[Service]
Type=simple
# Reuse the app's bundled Electron in Node mode — no separate Node runtime
# dependency. /opt/sentinel-dvpn is a space-free symlink to "/opt/Sentinel dVPN"
# created by the postinstall, so the ExecStart needs no quoting/escaping.
Environment=ELECTRON_RUN_AS_NODE=1
ExecStart=/opt/sentinel-dvpn/sentinel-dvpn-app /opt/sentinel-dvpn/resources/daemon/index.js
# systemd creates/owns /run/sentinel-dvpn (where the daemon binds its socket).
RuntimeDirectory=sentinel-dvpn
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2

# Conservative hardening (finding: systemd daemon confinement). These do NOT
# interfere with the daemon's work (spawning wg-quick/iptables/ip/tun2socks via
# the helper, writing /etc/resolv.conf, binding its AF_UNIX socket). Intentionally
# omitted: ProtectSystem/ProtectKernelModules (would block wg-quick's modprobe and
# the /etc/resolv.conf rewrite), RestrictAddressFamilies (ip/iptables need
# AF_NETLINK), and a CapabilityBoundingSet (wg-quick needs broad caps) — those
# require on-target verification before enabling.
NoNewPrivileges=true
ProtectHome=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
